<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- NuGet metadata -->
    <PackageId>ReliableWebhooks</PackageId>
    <Title>ReliableWebhooks</Title>
    <Authors>Rodrigo de Oliveira</Authors>
    <Description>
      Reliable outbound webhook delivery primitives for .NET 10 with explicit delivery outcomes and extensible transport behavior.
    </Description>
    <PackageTags>dotnet;csharp;library;webhooks;http;reliability</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- NuGet presentation -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>nuget-icon.png</PackageIcon>

    <!-- Repository -->
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Documentation and symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md"
          Pack="true"
          PackagePath="/" />

    <None Include="../../resources/nuget-icon.png"
          Pack="true"
          PackagePath="/" />
  </ItemGroup>
</Project>
